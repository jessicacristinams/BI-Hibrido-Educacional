# Processado pelo envsubst da imagem oficial do nginx: ${VARIAVEIS} vêm do docker-compose.yml.

# Limite de perguntas ao chat por endereço IP.
limit_req_zone $binary_remote_addr zone=chat:1m rate=${CHAT_LIMITE_POR_MINUTO}r/m;

server {
    listen 80;
    server_name _;

    # Senha única para o grupo (gerada por /docker-entrypoint.d/40-senha.sh).
    auth_basic "Sigadash";
    auth_basic_user_file /etc/nginx/senhas/.htpasswd;

    # Filtros de múltipla escolha vão na URL dos GETs dos painéis (ex.: várias disciplinas).
    large_client_header_buffers 4 32k;

    # Respostas JSON da API comprimidas.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    root /usr/share/nginx/html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Arquivos com hash no nome nunca mudam.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /api/chat {
        limit_req zone=chat burst=${CHAT_RAJADA} nodelay;
        limit_req_status 429;

        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Modelos locais (Ollama sem GPU) podem levar alguns minutos.
        proxy_read_timeout 300s;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Resposta em JSON para o chat mostrar a mensagem (em vez da página padrão do nginx).
    error_page 429 = @limite;
    location @limite {
        default_type application/json;
        return 429 '{"detail":"Muitas perguntas em pouco tempo. Aguarde um minuto e tente de novo."}';
    }
}
