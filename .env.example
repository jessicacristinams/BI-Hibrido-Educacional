# Configuração da publicação (docker compose). Copie para .env e preencha.

# ── Acesso ──────────────────────────────────────────────────────────────
PORTA=8080
SIGADASH_USUARIO=sigadash
SIGADASH_SENHA=troque-esta-senha

# Perguntas ao chat por minuto, por computador (IP), e quantas podem vir de uma vez.
CHAT_LIMITE_POR_MINUTO=10
CHAT_RAJADA=5

# Opcional (LGPD): com valor > 1, os painéis ocultam números de grupos com menos de SUPRESSAO_K
# alunos/matrículas (ex.: 5). 1 = mostra os valores reais, iguais aos do chat.
SUPRESSAO_K=1

# ── Modelo de linguagem: escolha UMA das opções ─────────────────────────

# Opção 1 — API da OpenAI
OPENAI_API_KEY=sk-sua-chave-aqui
LLM_MODEL=gpt-4o-mini

# Opção 2 — Ollama no próprio servidor (docker compose --profile ollama ...)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5-coder:14b
# LLM_TIMEOUT_S=180
